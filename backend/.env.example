# Copy to backend/.env and adjust. Never commit real secrets.
FRAMEWORK_STORAGE_DIR=./storage
FRAMEWORK_MAX_UPLOAD_MB=2048
FRAMEWORK_FFPROBE_PATH=ffprobe
FRAMEWORK_FFMPEG_PATH=ffmpeg
FRAMEWORK_CORS_ORIGINS=["http://localhost:3000"]

# Speech-to-text model for cutting fillers: tiny, base, small, medium, large-v3 (empty = off)
FRAMEWORK_WHISPER_MODEL=small

# Optional: enables the Claude editor in the timeline chat and the Claude creative director.
# Without it, the free rule-based modes are used.
# ANTHROPIC_API_KEY=sk-ant-...
